# Copier en .env pour le développement local (ne jamais committer .env)

# Base de données : SQLite par défaut ; en production, une base Postgres gratuite (Neon, Supabase)
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote/base?sslmode=require

# Comptes du dashboard : "utilisateur:motdepasse" séparés par des virgules
DASHBOARD_USERS=superviseur:changez-moi,agent1:changez-moi-aussi

# Clé pour signer les jetons CSRF (chaîne aléatoire longue)
SECRET_KEY=remplacez-par-une-chaine-aleatoire

# Jeton partagé avec le REST Service Kobo (?token=... dans l'URL du webhook)
KOBO_WEBHOOK_TOKEN=remplacez-par-un-jeton-aleatoire

# Optionnel : synchronisation (rattrapage) via l'API Kobo
KOBO_SERVER_URL=https://kf.kobotoolbox.org
KOBO_API_TOKEN=
KOBO_ASSET_UID=

# Optionnel : marge de la "zone grise" autour du seuil (par défaut : valeur enregistrée avec le modèle, 0.30)
# REVIEW_BAND=0.30
